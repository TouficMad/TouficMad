{
  "uid": "voip-routing",
  "title": "Voice Routing Quality",
  "tags": [
    "voip",
    "routing"
  ],
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "10s",
  "templating": {
    "list": [
      {
        "name": "carrier",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(voip_calls_total, carrier)",
          "refId": "v"
        },
        "definition": "label_values(voip_calls_total, carrier)",
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      },
      {
        "name": "destination",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(voip_calls_total, destination)",
          "refId": "v"
        },
        "definition": "label_values(voip_calls_total, destination)",
        "multi": true,
        "includeAll": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Global ASR",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.35
              },
              {
                "color": "green",
                "value": 0.45
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(voip_calls_answered_total{carrier=~\"$carrier\",destination=~\"$destination\"}[5m])) / sum(rate(voip_calls_total{carrier=~\"$carrier\",destination=~\"$destination\"}[5m]))",
          "legendFormat": "ASR"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Global NER",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.85
              },
              {
                "color": "green",
                "value": 0.9
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(voip_calls_network_effective_total{carrier=~\"$carrier\",destination=~\"$destination\"}[5m])) / sum(rate(voip_calls_total{carrier=~\"$carrier\",destination=~\"$destination\"}[5m]))",
          "legendFormat": "NER"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Calls per second",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(voip_calls_total{carrier=~\"$carrier\",destination=~\"$destination\"}[1m]))",
          "legendFormat": "cps"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Active alerts",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(ALERTS{alertstate=\"firing\", alertname=~\"Voip.*\"}) or vector(0)",
          "legendFormat": "alerts"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "ASR by route",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "route:voip_asr:ratio_rate5m{carrier=~\"$carrier\",destination=~\"$destination\"}",
          "legendFormat": "{{carrier}} \u2192 {{destination}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "NER by route",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "route:voip_ner:ratio_rate5m{carrier=~\"$carrier\",destination=~\"$destination\"}",
          "legendFormat": "{{carrier}} \u2192 {{destination}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "p95 PDD by route",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "route:voip_pdd_seconds:p95_5m{carrier=~\"$carrier\",destination=~\"$destination\"}",
          "legendFormat": "{{carrier}} \u2192 {{destination}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "ACD by route",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "route:voip_acd_seconds:rate5m{carrier=~\"$carrier\",destination=~\"$destination\"}",
          "legendFormat": "{{carrier}} \u2192 {{destination}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Failures by SIP code",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (sip_code) (rate(voip_calls_total{carrier=~\"$carrier\",destination=~\"$destination\",sip_code!=\"200\"}[5m]))",
          "legendFormat": "SIP {{sip_code}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 10,
      "type": "barchart",
      "title": "Minutes per hour by carrier",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 23,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (carrier) (route:voip_minutes:rate1h{carrier=~\"$carrier\",destination=~\"$destination\"})",
          "legendFormat": "{{carrier}}",
          "instant": true,
          "format": "table"
        }
      ]
    },
    {
      "id": 11,
      "type": "table",
      "title": "Routing plan (LCR with quality floor): priority 0 = blocked",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "ASR (window)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Cost / min"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 4
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Avg PDD (s)"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Priority"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "green",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "voip_route_priority{carrier=~\"$carrier\",destination=~\"$destination\"}",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "voip_carrier_cost_per_minute{carrier=~\"$carrier\",destination=~\"$destination\"}",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "expr": "voip_asr_ratio{carrier=~\"$carrier\",destination=~\"$destination\"}",
          "instant": true,
          "format": "table"
        },
        {
          "refId": "D",
          "expr": "voip_avg_pdd_seconds{carrier=~\"$carrier\",destination=~\"$destination\"}",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "renameByName": {
              "Value #A": "Priority",
              "Value #B": "Cost / min",
              "Value #C": "ASR (window)",
              "Value #D": "Avg PDD (s)"
            },
            "indexByName": {
              "destination": 0,
              "Value #A": 1,
              "carrier": 2,
              "Value #B": 3,
              "Value #C": 4,
              "Value #D": 5
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "destination"
              },
              {
                "field": "Priority"
              }
            ]
          }
        }
      ]
    }
  ]
}